{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fgo-shortener",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DBLocal",
			"database_name": "fgo-shortener-db",
			"database_id": "00000000-0000-0000-0000-000000000001"
		},
		{
			"binding": "DBRemote",
			"database_name": "fgo-shortener-db",
			"database_id": "e7127f3f-a9b0-4dc5-9609-d03e28b2749f"
		}
	],
	"ratelimits": [
		{
			"name": "CREATE_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	]
}