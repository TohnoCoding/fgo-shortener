{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fgolist",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fgo-shortener-db",
			"database_id": "00000000-0000-0000-0000-000000000001"
		}
	],
	"env": {
		"production": {
			"name": "list",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "fgo-shortener-db",
					"database_id": "e7127f3f-a9b0-4dc5-9609-d03e28b2749f"
				}
			],
			"ratelimits": [
				{
					"name": "CREATE_RATE_LIMITER",
					"namespace_id": "1001",
					"simple": {
						"limit": 5,
						"period": 60
					}
				}
			],
			"vars": {
				"ALLOWED_ORIGIN": "https://tohnocoding.github.io",
				"ALLOWED_HOSTNAME": "tohnocoding.github.io",
				"ALLOWED_PATHNAME": "/fgochecklist/"
			}
		}
	}
}